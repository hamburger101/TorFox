// Generated by CMake from docs/release-notes/<version>.txt: this version's
// release notes, shown on the What's new page after an update. Empty for a
// version that has none (a development build).

#ifndef TORFOX_BROWSER_APP_RELEASE_NOTES_H_
#define TORFOX_BROWSER_APP_RELEASE_NOTES_H_

#include <cstddef>
#include <string_view>

namespace torfox {
inline constexpr unsigned char kReleaseNotesData[] = {@TORFOX_RELEASE_NOTES_BYTES@ 0};
inline constexpr std::size_t kReleaseNotesSize = @TORFOX_RELEASE_NOTES_SIZE@;

inline std::string_view ReleaseNotes() {
  return std::string_view(reinterpret_cast<const char*>(kReleaseNotesData), kReleaseNotesSize);
}
}  // namespace torfox

#endif  // TORFOX_BROWSER_APP_RELEASE_NOTES_H_
